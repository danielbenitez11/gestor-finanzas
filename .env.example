# Copia este fichero como .env y rellena los valores.
# El .env real NUNCA se sube a git: contiene secretos.

# ─────────────────────────────────────────────────────────────
# EN TU ORDENADOR (desarrollo)
# ─────────────────────────────────────────────────────────────

# Fichero SQLite local. La ruta es relativa a la raíz del proyecto.
DATABASE_URL="file:./prisma/dev.db"

# Clave con la que se firman las cookies de sesión.
# Genera una nueva y distinta para producción:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="pon-aqui-una-clave-larga-y-aleatoria"

# Dirección desde la que se sirve la aplicación.
BETTER_AUTH_URL="http://localhost:3000"


# ─────────────────────────────────────────────────────────────
# EN PRODUCCIÓN (Vercel + Turso)
# ─────────────────────────────────────────────────────────────
# Estas NO se ponen aquí: se configuran en el panel de Vercel.
# Si TURSO_DATABASE_URL existe, la aplicación se conecta a Turso e
# ignora DATABASE_URL. Ese es el interruptor entre local y producción.
#
#   TURSO_DATABASE_URL="libsql://tu-base.turso.io"
#   TURSO_AUTH_TOKEN="el-token-que-te-da-turso"
#   BETTER_AUTH_SECRET="otra-clave-distinta-de-la-de-desarrollo"
#   BETTER_AUTH_URL="https://tu-app.vercel.app"
