# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...pero el ejemplo SÍ se sube: no tiene secretos, solo los nombres.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# base de datos local (contiene datos personales)
*.db
*.db-journal
*.sqlite

# Documentación para asistentes de IA que instala `prisma init`. Se descarga de
# github.com/prisma/skills y se restaura desde skills-lock.json, igual que
# node_modules se restaura desde package-lock.json.
# .claude y .windsurf son enlaces (junctions) a .agents: git guardaría el mismo
# contenido tres veces.
/.agents/
/.claude/
/.windsurf/
/docs/

# Índice local de CodeGraph (base de datos SQLite del grafo del código).
# Se regenera con `codegraph init`; no tiene sentido versionarlo.
/.codegraph/
/.obsidian/